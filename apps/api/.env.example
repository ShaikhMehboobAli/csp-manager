# ==============================================================================
# CSP Manager API - Environment Configuration Example
# ==============================================================================
# Copy this file to .env and replace placeholder values with your real configuration:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
# Set to 'production' on live VPS deployments
NODE_ENV=production

# Server listening port (default: 3000)
PORT=3000

# Base API route prefix (default: /api/v1)
API_PREFIX=/api/v1

# Trust proxy hop count.
# Set to 1 when running behind Nginx / Cloudflare reverse proxy so express-rate-limit
# reads the actual client IP from X-Forwarded-For rather than 127.0.0.1.
TRUST_PROXY=1

# Application logging level: debug | info | warn | error
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. DATABASE SETTINGS (PostgreSQL)
# ------------------------------------------------------------------------------
# Connection string for PostgreSQL (Neon, DigitalOcean Managed DB, or local Postgres)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require
DATABASE_URL=postgresql://postgres:your_secure_db_password@localhost:5432/csp_manager?schema=public

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Generate strong 64-char random secrets using: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_key
JWT_REFRESH_SECRET=replace_with_another_secure_random_64_character_hex_secret_key

# Token expiration durations
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Enforce hardware device key signatures for desktop machines.
# Keep 'false' until desktop clients ship ECDSA signature support.
MACHINE_SIGNATURE_REQUIRED=false

# ------------------------------------------------------------------------------
# 4. SUPER ADMIN INITIAL SEED CREDENTIALS
# ------------------------------------------------------------------------------
# Used when running 'npm run seed:super-admin' or 'npx prisma db seed'
SUPER_ADMIN_AGENT_ID=SUPERADMIN
SUPER_ADMIN_EMAIL=admin@yourdomain.com
# Must be at least 12 characters long
SUPER_ADMIN_PASSWORD=change_this_to_a_strong_password_min_12_chars
# Set to true only if you want to overwrite/reset an existing super admin password
SUPER_ADMIN_RESET_PASSWORD=false

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY (Razorpay)
# ------------------------------------------------------------------------------
# Razorpay API credentials from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Webhook secret configured in Razorpay Dashboard for webhook events
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Maximum amount allowed per UPI AutoPay debit in rupees (default: 15000)
RAZORPAY_MANDATE_MAX_AMOUNT=15000

# Set to true if recurring subscriptions should register mandate on initial checkout
RAZORPAY_AUTOPAY_ON_PURCHASE=false

# Legacy / Stand-in webhook secret (dev testing only)
PAYMENT_WEBHOOK_SECRET=

# Production guard: must be false in production
ALLOW_MANUAL_MANDATES=false

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL (Resend)
# ------------------------------------------------------------------------------
# Resend API key for OTPs, password reset, and activation emails (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender email address (e.g., CSP Manager <noreply@yourdomain.com>)
EMAIL_FROM="CSP Manager <noreply@yourdomain.com>"
EMAIL_REPLY_TO="support@yourdomain.com"

# Daily email rate limit cap (0 = unlimited)
EMAIL_DAILY_LIMIT=0

# ------------------------------------------------------------------------------
# 7. PUSH NOTIFICATIONS (Firebase Cloud Messaging)
# ------------------------------------------------------------------------------
# Provide either the JSON string OR the absolute/relative file path:
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json

# ------------------------------------------------------------------------------
# 8. OBJECT STORAGE (AWS S3)
# ------------------------------------------------------------------------------
# Used for receipt slip uploads, inspection photos, and diagnostic files
AWS_REGION=ap-south-1
AWS_S3_BUCKET=csp-manager-uploads
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# ------------------------------------------------------------------------------
# 9. RUNTIME & CRON JOB SETTINGS
# ------------------------------------------------------------------------------
# Allow machine receipt uploads
RECEIPT_UPLOAD_ENABLED=true

# Desktop heartbeat timings (seconds)
HEARTBEAT_INTERVAL=60
HEARTBEAT_TIMEOUT=120

# Data retention policies (in days)
RECEIPT_RETENTION_DAYS=60
RECEIPT_COUNT_RETENTION_DAYS=365
SESSION_RETENTION_DAYS=180

# When true, retention cleanup jobs only log without deleting.
# Set to 'false' in production so database storage is cleaned up.
CLEANUP_DRY_RUN=false
