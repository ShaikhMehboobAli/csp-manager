// ---------------------------------------------------------------------------
// Cash management. A CSP and its KOs share one cash limit and one cash in
// account (the pool); each agent has its own cash in hand and drawer.
// Invariant: cashInAccount + sum(cashInHand of the CSP and its KOs) = cashLimit.
// ---------------------------------------------------------------------------

enum CashLedgerType {
  // Pool opened (CSP signup / BC creates the CSP / first setup).
  OPENING
  // A KO joined the pool with its cash in hand (taken from cash in account).
  AGENT_ADDED
  // Cash receipt applied to the balances.
  RECEIPT
  // Cash receipt saved but not applied (balance short or pool not set up).
  RECEIPT_NOT_APPLIED
  // CSP moved cash between cash in account and an agent's cash in hand.
  SETTLEMENT
  // CSP set balances / limit / drawer manually.
  ADJUSTMENT
  // CSP approved a KO's change request.
  REQUEST_APPROVED
  // A KO's bank → cash in hand settlement took its amount out of left in bank (held).
  SETTLEMENT_HELD
  // Custom transaction with a CSP label (cash in / out outside SBI).
  CUSTOM
  // Balance due added / settled / cancelled.
  DUE_CREATED
  DUE_SETTLED
  DUE_CANCELLED
  // Notes swapped in the drawer (giving change); cash in hand unchanged.
  EXCHANGE
  // End-of-day count recorded; balances unchanged.
  DAY_CLOSE
  // Cash in hand and drawer counted when the agent's PC was activated.
  ACTIVATION
  // KO settlement, step 1: money leaves cash in account / cash in hand and
  // is held "in bank" (in transit).
  SETTLEMENT_TO_BANK
  // KO settlement, step 2: money held in bank reaches cash in hand / account.
  SETTLEMENT_FROM_BANK
  // An open settlement step was cancelled; money went back to where it came from.
  SETTLEMENT_CANCELLED
  // CSP increased / decreased an agent's cash in hand or the cash in account
  // (the cash limit moves with it).
  INCREASE
  DECREASE
  // The agent counted the notes for a CSP change (drawer only).
  DRAWER_ADJUSTED
  // KO removed (deleted): its cash in hand left the pool.
  AGENT_REMOVED
  // KO replaced: its cash in hand and drawer moved to the new KO.
  AGENT_TRANSFERRED
  // Desktop one-step move between cash in hand and cash in account.
  TRANSFER
}

enum CashLoginMethod {
  // SBI kiosk login with fingerprint (desktop activity start).
  KIOSK
  // Email OTP to the agent's verified email.
  EMAIL_OTP
}

enum AgentOtpPurpose {
  // Verify a (KO's) email at machine activation or in the cash panel.
  EMAIL_VERIFICATION
  // Log in to cash management on a PC of the family.
  CASH_LOGIN
}

/// Email OTPs for agents (KOs have no User, so Otp can't be used).
model AgentEmailOtp {
  id String @id @default(cuid())

  agentId String

  email String

  purpose AgentOtpPurpose

  codeHash String

  /// Machine the OTP was asked from (CASH_LOGIN / desktop verification).
  machineId String?

  expiresAt DateTime

  attempts Int @default(0)

  consumedAt DateTime?

  createdAt DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [agentId], onDelete: Cascade)

  @@index([agentId, purpose, createdAt])
}

enum CashAdjustmentSource {
  // The CSP moved cash in hand between agents while creating a KO.
  KO_CREATION
  // The CSP edited the agent's cash in hand in the app.
  CSP_EDIT
  // The CSP increased / decreased the agent's cash in hand in the app.
  CSP_INCREASE
  CSP_DECREASE
}

enum CashAdjustmentStatus {
  PENDING
  COMPLETED
  CANCELLED
}

/// The CSP changed an agent's cash in hand from the app: the agent must
/// count the notes given / taken on the desktop (mandatory "Adjust" request)
/// so the drawer matches the new cash in hand.
model CashDrawerAdjustment {
  id String @id @default(cuid())

  cspAgentId String

  agentId String

  source CashAdjustmentSource

  status CashAdjustmentStatus @default(PENDING)

  cashInHandBefore Decimal @db.Decimal(14, 2)
  cashInHandAfter  Decimal @db.Decimal(14, 2)

  /// after − before (+ = the CSP gave cash, − = the CSP took cash).
  amount Decimal @db.Decimal(14, 2)

  drawerBefore Json
  drawerAfter  Json?

  remarks String?

  requestedBy String

  completedAt DateTime?
  /// machineCode that completed it.
  completedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [agentId])

  @@index([agentId, status])
  @@index([cspAgentId, status])
}

enum CashSettlementDirection {
  // Cash in account → bank → cash in hand (the KO needs cash).
  ACCOUNT_TO_HAND
  // Cash in hand → bank → cash in account.
  HAND_TO_ACCOUNT
  // Left in bank → cash in hand (one step: FROM_BANK only).
  BANK_TO_HAND
}

enum CashSettlementStep {
  TO_BANK
  FROM_BANK
}

enum CashSettlementStatus {
  PENDING
  APPROVED
  CANCELLED
}

enum CashRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CashActorType {
  USER
  MACHINE
  SYSTEM
}

model CashPool {
  cspAgentId String @id

  cashLimit Decimal @db.Decimal(14, 2)

  cashInAccount Decimal @db.Decimal(14, 2)

  /// Money held in bank by open KO settlements (between step 1 and step 2).
  cashInTransit Decimal @default(0) @db.Decimal(14, 2)

  /// Left in bank when a KO settlement's step 2 delivered less than the
  /// amount; shown separately. Part of the pool: account + all cash in hand
  /// + in transit + left in bank = limit.
  cashLeftInBank Decimal @default(0) @db.Decimal(14, 2)

  /// Net cash from outside the SBI pool: custom transactions (shop
  /// expenses, bill collections) and settled dues; + = came in, − = went
  /// out. Shown separately. account + all cash in hand + in transit + left
  /// in bank = limit + other cash.
  cashOther Decimal @default(0) @db.Decimal(14, 2)

  /// Open "extra cash" balance dues (cashSide OTHER_CASH): + to collect,
  /// − to give. They move other cash at creation; this keeps the books
  /// balanced: account + all cash in hand + in transit + left in bank +
  /// extra cash held by dues = limit + other cash.
  cashDueExtra Decimal @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  csp Agent @relation(fields: [cspAgentId], references: [agentId])
}

model AgentCash {
  agentId String @id

  cashInHand Decimal @default(0) @db.Decimal(14, 2)

  // Drawer: note and coin counts (same keys as ReceiptCashDenomination).
  notes500 Int @default(0)
  notes200 Int @default(0)
  notes100 Int @default(0)
  notes50  Int @default(0)
  notes20  Int @default(0)
  notes10  Int @default(0)
  notes5   Int @default(0)
  coins20  Int @default(0)
  coins10  Int @default(0)
  coins5   Int @default(0)
  coins2   Int @default(0)
  coins1   Int @default(0)

  /// When the agent last read its task list (for "new from the CSP").
  tasksReadAt DateTime?

  updatedAt DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [agentId])
}

/// Audit of every change to a pool or an agent's cash.
model CashLedger {
  id String @id @default(cuid())

  cspAgentId String

  /// Whose cash in hand changed; null when only the pool changed.
  agentId String?

  type CashLedgerType

  /// RECEIPT_NOT_APPLIED: NOT_SET_UP | INSUFFICIENT_CASH_IN_HAND | INSUFFICIENT_CASH_IN_ACCOUNT
  reason String?

  transactionCategory TransactionCategory?

  /// Receipt / settlement amount.
  amount Decimal? @db.Decimal(14, 2)

  cashInHandChange     Decimal @default(0) @db.Decimal(14, 2)
  cashInAccountChange  Decimal @default(0) @db.Decimal(14, 2)
  cashLimitChange      Decimal @default(0) @db.Decimal(14, 2)
  cashInTransitChange  Decimal @default(0) @db.Decimal(14, 2)
  cashLeftInBankChange Decimal @default(0) @db.Decimal(14, 2)
  cashOtherChange      Decimal @default(0) @db.Decimal(14, 2)
  cashDueExtraChange   Decimal @default(0) @db.Decimal(14, 2)

  /// Balances after the change (hand = the agent's).
  balanceCashInHand     Decimal? @db.Decimal(14, 2)
  balanceCashInAccount  Decimal? @db.Decimal(14, 2)
  balanceCashLimit      Decimal? @db.Decimal(14, 2)
  balanceCashInTransit  Decimal? @db.Decimal(14, 2)
  balanceCashLeftInBank Decimal? @db.Decimal(14, 2)
  balanceCashOther      Decimal? @db.Decimal(14, 2)
  balanceCashDueExtra   Decimal? @db.Decimal(14, 2)

  /// Note/coin count changes, e.g. { "notes500": 2, "notes100": -1 }.
  drawerChange Json?

  receiptRecordId String?
  requestId       String?
  settlementId    String?
  dueId           String?
  idempotencyKey  String?

  actorType CashActorType
  actorId   String?

  remarks String?

  createdAt DateTime @default(now())

  agent   Agent?   @relation("CashLedgerAgent", fields: [agentId], references: [agentId])
  receipt Receipt? @relation(fields: [receiptRecordId], references: [id], onDelete: SetNull)

  @@unique([cspAgentId, idempotencyKey])
  @@index([cspAgentId, createdAt])
  @@index([agentId, createdAt])
  @@index([receiptRecordId])
}

/// A KO's request (from the desktop) to change its cash in hand / drawer;
/// the CSP approves or rejects it.
model CashRequest {
  id String @id @default(cuid())

  cspAgentId String

  agentId String

  requestedCashInHand Decimal @db.Decimal(14, 2)

  /// The agent's cash in hand when the request was made.
  systemCashInHand Decimal @db.Decimal(14, 2)

  requestedDrawer Json?

  reason String

  status CashRequestStatus @default(PENDING)

  requestedBy String

  reviewedBy    String?
  reviewedAt    DateTime?
  reviewRemarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [agentId])

  @@index([cspAgentId, status])
  @@index([agentId, status])
}

/// A KO's own settlement step (desktop). Step 1 (TO_BANK) moves the amount
/// into "in bank" (CashPool.cashInTransit); approving it creates step 2
/// (FROM_BANK), which delivers it. The CSP is only informed.
model CashSettlement {
  id String @id @default(cuid())

  cspAgentId String

  agentId String

  direction CashSettlementDirection

  step CashSettlementStep

  status CashSettlementStatus @default(PENDING)

  /// Amount held in bank by this step.
  amount Decimal @db.Decimal(14, 2)

  /// Step 2: amount that reached the destination, at most `amount`
  /// (ACCOUNT_TO_HAND: the counted notes); the rest is left in bank.
  settledAmount Decimal? @db.Decimal(14, 2)

  /// Notes taken out of (step 1, HAND_TO_ACCOUNT) or put into (step 2,
  /// ACCOUNT_TO_HAND) the drawer.
  drawer Json?

  /// Step 2 points to its step 1.
  parentId String? @unique

  remarks String?

  requestedBy String
  reviewedBy  String?
  reviewedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent  Agent           @relation(fields: [agentId], references: [agentId])
  parent CashSettlement? @relation("SettlementSteps", fields: [parentId], references: [id])
  child  CashSettlement? @relation("SettlementSteps")

  @@index([cspAgentId, status])
  @@index([agentId, status, createdAt])
}

enum CashLabelDirection {
  IN
  OUT
  BOTH
}

enum CashFlowDirection {
  IN
  OUT
}

enum CashDueKind {
  // The customer owes the agent.
  TO_COLLECT
  // The agent owes the customer.
  TO_GIVE
}

enum CashDueSource {
  RECEIPT
  CUSTOM
  MANUAL
}

/// Where a due's amount is put when it's added (dues without a receipt).
enum CashDueSide {
  CASH_IN_HAND
  CASH_IN_ACCOUNT
  OTHER_CASH
}

enum CashDueStatus {
  OPEN
  SETTLED
  CANCELLED
}

enum CashTaskCreator {
  KO
  CSP
}

/// A CSP's label for custom transactions (only the CSP creates them).
model CashLabel {
  id String @id @default(cuid())

  cspAgentId String

  name String

  direction CashLabelDirection

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cspAgentId, name])
}

/// Cash moved outside SBI with a CSP label (desktop).
model CashCustomTransaction {
  id String @id @default(cuid())

  cspAgentId String

  agentId String

  labelId String

  /// Label name when it was made (labels can be renamed).
  labelName String

  direction CashFlowDirection

  amount Decimal @db.Decimal(14, 2)

  /// Paid now (≤ amount); the rest became a balance due.
  paidNow Decimal @db.Decimal(14, 2)

  drawer Json?

  note String?

  machineCode String

  createdAt DateTime @default(now())

  @@index([agentId, createdAt])
}

/// Work done but cash not yet taken or given.
model CashDue {
  id String @id @default(cuid())

  cspAgentId String

  agentId String

  kind CashDueKind

  source CashDueSource

  /// Still due (a part payment lowers it).
  amount Decimal @db.Decimal(14, 2)

  originalAmount Decimal @db.Decimal(14, 2)

  receiptRecordId     String?
  receiptId           String?
  customTransactionId String?

  label String?

  note String?

  status CashDueStatus @default(OPEN)

  /// RECEIPT dues on an applied receipt: creating it moved the unpaid
  /// amount out of (TO_COLLECT) or into (TO_GIVE) cash in hand.
  holdsCash Boolean @default(false)

  /// Dues without a receipt: where the amount was put at creation (moved
  /// back when it's settled or cancelled). Null = nothing moved.
  cashSide CashDueSide?

  /// Receipt dues: the notes taken out of / put into the drawer at creation.
  drawer Json?

  createdBy String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  settledAt DateTime?

  agent Agent @relation(fields: [agentId], references: [agentId])

  @@index([agentId, status])
  @@index([cspAgentId, status])
}

/// Notes swapped in an agent's drawer (giving change).
model CashExchange {
  id String @id @default(cuid())

  cspAgentId String

  agentId String

  taken Json
  given Json

  amount Decimal @db.Decimal(14, 2)

  note String?

  machineCode String

  createdAt DateTime @default(now())

  @@index([agentId, createdAt])
}

/// An agent's end-of-day count (IST day). Balances don't change.
model CashDayClose {
  id String @id @default(cuid())

  cspAgentId String

  agentId String

  /// IST calendar day.
  date DateTime @db.Date

  systemCashInHand Decimal @db.Decimal(14, 2)
  systemDrawer     Json

  countedCashInHand Decimal @db.Decimal(14, 2)
  countedDrawer     Json

  /// counted − system (negative = short).
  difference Decimal @db.Decimal(14, 2)

  machineCode String

  closedAt DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [agentId])

  @@unique([agentId, date])
  @@index([cspAgentId, date])
}

/// An agent's to-do, shared with its CSP.
model CashTask {
  id String @id @default(cuid())

  cspAgentId String

  agentId String

  title String

  note String?

  dueAt DateTime?

  done   Boolean   @default(false)
  doneAt DateTime?

  createdBy CashTaskCreator

  /// machineCode (KO) or userId (CSP).
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [agentId])

  @@index([agentId, done])
  @@index([cspAgentId])
}

/// Desktop writes sent with an Idempotency-Key: a retry within 24 h gets the
/// first answer back instead of doing the action twice.
model MachineIdempotencyKey {
  id String @id @default(cuid())

  machineCode String

  key String

  method String
  path   String

  /// Null while the first request is still running.
  statusCode Int?
  response   Json?

  createdAt DateTime @default(now())

  @@unique([machineCode, key])
  @@index([createdAt])
}

enum CommissionGroup {
  FINANCIAL
  NON_FINANCIAL
  ENROLMENT
}

enum CommissionRateType {
  // ₹ per successful transaction / enrolment
  FLAT
  // % of the receipt amount (optional min / max per receipt)
  PERCENT
  // BC / CSP override removed from this date: the next level applies
  INHERIT
  // Amount bands (slabs), each FLAT or PERCENT; the band the receipt
  // amount falls in applies
  SLAB
}

enum CommissionScope {
  DEFAULT
  BC
  CSP
}

/// A service commission is paid on: a transaction category, optionally one
/// receipt type of it (e.g. SOCIAL_SECURITY + PMJJBY).
model CommissionService {
  id String @id @default(cuid())

  code String @unique

  name String

  transactionCategory TransactionCategory

  /// null = every receipt type of the category not listed on its own.
  receiptType ReceiptType?

  group CommissionGroup

  sortOrder Int @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rates CommissionRate[]
}

/// A rate for one service, at one scope, from `effectiveFrom` until the next
/// rate of the same service + scope. Set by the super admin. Precedence when
/// a receipt is saved: the CSP's rate, else its BC's, else DEFAULT.
model CommissionRate {
  id String @id @default(cuid())

  serviceId String

  scope CommissionScope

  /// "" for DEFAULT; the BC id or the CSP agentId.
  scopeId String @default("")

  type CommissionRateType

  /// FLAT: ₹ per receipt.
  amount Decimal? @db.Decimal(12, 2)

  /// PERCENT: % of the receipt amount.
  percent Decimal? @db.Decimal(7, 4)

  minAmount Decimal? @db.Decimal(12, 2)
  maxAmount Decimal? @db.Decimal(12, 2)

  /// SLAB: [{ from, to (null = no upper limit), type: FLAT | PERCENT,
  /// amount?, percent? }] sorted by `from`; `from` inclusive, `to` exclusive.
  slabs Json?

  effectiveFrom DateTime

  reason String?

  createdBy String

  createdAt DateTime @default(now())

  service CommissionService @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([serviceId, scope, scopeId, effectiveFrom])
  @@index([scope, scopeId])
}

enum ReceiptReportStatus {
  OPEN
  RESOLVED
  REJECTED
}

/// "Report a problem" on a receipt, raised from the app. Keeps a copy of the
/// receipt so the report survives receipt retention.
model ReceiptReport {
  id String @id @default(cuid())

  /// Receipt row id (not a relation: the receipt can be deleted by retention).
  receiptRowId String

  receiptId String

  /// Owner (CSP agentId) of the machine the receipt came from.
  ownerAgentId String

  reportedBy String

  reason String

  details String?

  status ReceiptReportStatus @default(OPEN)

  receiptSnapshot Json

  resolution String?

  resolvedBy String?

  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([ownerAgentId, createdAt])
  @@index([receiptRowId])
}
