enum SubscriptionOwnerType {
  BC
  CSP
}

enum SubscriptionEventType {
  PURCHASE
  UPGRADE
  RENEWAL
  CANCELLATION
  // A mandate charge failed (one row per attempt).
  RENEWAL_FAILED
  // Renewal failed after every retry; the subscription stopped at once.
  LAPSED
  // Free trial started by the owner / extended by the super admin.
  TRIAL_STARTED
  TRIAL_EXTENDED
}

/// What a payment pays for.
enum PaymentPurpose {
  // New subscription (first one, or after the last one ended / was cancelled).
  PURCHASE
  // Higher plan and/or more machines on the running subscription (difference only).
  UPGRADE
  // Monthly mandate charge (auto renewal).
  RENEWAL
}

/// Recurring UPI mandate (autopay) that renews a subscription every month.
enum MandateStatus {
  // Created; waiting for the customer to approve it in the UPI app.
  PENDING
  ACTIVE
  // Cancelled by the CSP in our app (subscription cancelled).
  CANCELLED
  // Removed by the customer in the UPI app / bank, or rejected by the gateway.
  REVOKED
  // Ran its full term (25 years) or the gateway closed it.
  COMPLETED
  // The plan's price changed: cancelled and replaced by a new mandate at the
  // new price.
  REPLACED
}

enum MandateProvider {
  RAZORPAY
  // Development stand-in: charges succeed/fail per DEV_MANDATE_RESULT.
  MANUAL
}

enum SubscriptionType {
  TRIAL
  PAID
  PROMOTIONAL
  LIFETIME
}

enum MachineStatus {
