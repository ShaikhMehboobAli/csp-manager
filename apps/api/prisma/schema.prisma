///////////////////////////
//Payment Model
///////////////////////////

model Payment {
  id String @id @default(cuid())

  paymentNumber String @unique

  subscriptionId String?

  ownerType SubscriptionOwnerType

  ownerId String

  // CSP plans are priced per machine: amount = price × machineCount, and the
  // subscription gets that many machine slots. Always 1 for BC plans.
  machineCount Int @default(1)

  bcId String?

  amount Decimal @db.Decimal(12, 2)

  taxAmount Decimal @default(0) @db.Decimal(12, 2)

  totalAmount Decimal @db.Decimal(12, 2)

  paymentMethod PaymentMethod

  paymentProvider PaymentProvider

  status PaymentStatus

  transactionReference String?

  gatewayTransactionId String? @unique

  gatewayResponse Json?

  receiptUrl String?

  failureReason String?

  remarks String?

  paidAt DateTime?

  planId String

  billingCycle BillingCycle

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  currency String @default("INR")

  invoiceNumber String? @unique

  // Client-supplied Idempotency-Key: a retried create-order returns the same
  // payment instead of opening a second one.
  idempotencyKey String?

  @@unique([ownerId, idempotencyKey])
  @@index([subscriptionId])
  @@index([status])
  @@index([paymentMethod])
  @@index([paidAt])
  @@index([paymentProvider])
  @@index([paymentNumber])
}

