enum TransactionCategory {
  CASH_DEPOSIT
  CASH_WITHDRAWAL
  MONEY_TRANSFER
  FUND_TRANSFER
  BALANCE_ENQUIRY
  MINI_STATEMENT
  ACCOUNT_OPENING
  BBPS
  MICRO_ATM
  SOCIAL_SECURITY
  LOAN
  OTHER
}

enum MetricCategory {
  SOCIAL_SECURITY
  TRANSACTION
  VISIT
  MANUAL
  OTHER
}

enum MetricSource {
  RECEIPT
  MANUAL
}

enum MetricInputType {
  COUNT
  NUMBER
  BOOLEAN
}

//enum FloatLedgerType {
// OPENING
// RECEIPT
// ADJUSTMENT
// LIMIT_TOPUP
// LIMIT_REDUCTION
// CORRECTION
// RENEWAL_ADJUSTMENT
//}

enum FloatLedgerType {
  OPENING

  RECEIPT

  OPENING_ADJUSTMENT

  ADJUSTMENT

  LIMIT_TOPUP

  LIMIT_REDUCTION

  CORRECTION

  RENEWAL_ADJUSTMENT
}

enum FloatAdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FloatAdjustmentReason {
  RENEWAL
  MANUAL_CORRECTION
  INITIAL_SETUP
  DEVICE_REPLACEMENT
  SYSTEM_RECOVERY
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE

  LOGIN
  LOGOUT

  ACTIVATE
  DEACTIVATE

  SUBSCRIPTION_CREATED
  SUBSCRIPTION_UPGRADED
  SUBSCRIPTION_CANCELLED
  SUBSCRIPTION_RENEWED

  FLOAT_ADJUSTMENT
  LIMIT_TOPUP
  LIMIT_REDUCTION

  PLAN_CREATED
  PLAN_UPDATED

  MACHINE_REGISTERED
  MACHINE_TRANSFERRED

  SETTINGS_UPDATED

  PAYMENT_CREATED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
}

enum AuditEntity {
  USER
  BC
  AGENT
  PLAN
  PLAN_PRICING
  SUBSCRIPTION
  MACHINE
  ACTIVATION
  RECEIPT
  AGENT_FLOAT
  PAYMENT
  SYSTEM_SETTING
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  RAZORPAY
  CASH
  BANK_TRANSFER
  UPI
  MANUAL
}

enum PaymentProvider {
  RAZORPAY
  MANUAL
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

//////////////////////////////////////////////////
// MODELS
//////////////////////////////////////////////////

//////////////////////////////////////////////////
// User MODELS
//////////////////////////////////////////////////

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
  SUSPENDED
}

model User {
  id String @id @default(cuid())

  agentId String @unique

  email String @unique

  passwordHash String

  role UserRole

  status UserStatus @default(PENDING)

  isEmailVerified Boolean @default(false)

  isPhoneVerified Boolean @default(false)

  signupCompleted Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  createdBy String?
  updatedBy String?

  lastLoginAt DateTime?

  passwordChangedAt DateTime?

  agent Agent @relation(fields: [agentId], references: [agentId])

  sessions UserSession[]

  notifications Notification[]

  communications Communication[]

  auditLogs AuditLog[]

  OTP Otp[]

  @@index([agentId])
}

///////////////////////////
//User Session Model
///////////////////////////

model UserSession {
  id String @id @default(cuid())

  userId String

  refreshTokenHash String

  ipAddress String?

  userAgent String?

  deviceName String?

  expiresAt DateTime

  revokedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

///////////////////////////
//OTP Model
///////////////////////////

enum OtpPurpose {
  SIGNUP
  LOGIN
  FORGOT_PASSWORD
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
}

enum OTPChannel {
  EMAIL
  SMS
}

model Otp {
  id String @id @default(cuid())

  userId String

  purpose OtpPurpose

  otpCode String

  email String?

  phone String?

  expiresAt DateTime

  attempts Int @default(0)

  resendCount Int @default(0)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([purpose])
}

///////////////////////////
//BC Model
///////////////////////////

model BusinessCorrespondent {
  id String @id @default(cuid())

  bcId String @unique
  name String

  mobile  String?
  email   String?
  address String?

  status BusinessCorrespondentStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agents Agent[]

  deletedAt DateTime?

  deletedByUserId String?

  isDeleted Boolean @default(false)

  @@index([status])
}

///////////////////////////
//Agent Model
///////////////////////////

model Agent {
  id String @id @default(cuid())

  agentId String @unique

  name String

  type AgentType

  mobile  String?
  email   String?
  address String?

  status AgentStatus @default(ACTIVE)

  selfRegistered Boolean @default(false)

  // Relationship with BC
  bcId                  String?
  businessCorrespondent BusinessCorrespondent? @relation(fields: [bcId], references: [bcId], onDelete: Restrict)

  // Self Relationship (CSP -> KO)
  parentAgentId String?

  parentAgent Agent? @relation("AgentHierarchy", fields: [parentAgentId], references: [agentId], onDelete: SetNull)

  childAgents Agent[] @relation("AgentHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cashLimit   Decimal? @db.Decimal(18, 2)
  openingCash Decimal? @db.Decimal(18, 2)

  linkedAt DateTime?

  receipts Receipt[]

  users User?

  cspVisits CspVisit[] @relation("CspVisits")

  conductedCspVisits CspVisit[] @relation("CspVisitsByAgent")

  isDeleted Boolean @default(false)

  deletedByUserId String?

  deletedAt              DateTime?
  agentFloat             AgentFloat?
  floatLedger            FloatLedger[]
  floatAdjustmentRequest FloatAdjustmentRequest[]
  metricValues           MetricValue[]

  machines Machine[]

  isProfileCompleted Boolean @default(false)

  createdByAgentId String?

  createdBy String?
  updatedBy String?

  @@index([bcId])
  @@index([parentAgentId])
  @@index([type])
  @@index([status])
}

///////////////////////////
//Plan Model
///////////////////////////

model Plan {
  id String @id @default(cuid())

  code String @unique
  name String

  ownerType PlanOwnerType

  level Int

  machineLimit Int?

  isCustom Boolean @default(false)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pricings PlanPricing[]

  features PlanFeature[]

  subscriptions Subscription[]

  payments Payment[]

  deletedAt       DateTime?
  deletedByUserId String?

  isDeleted Boolean @default(false)

  @@index([ownerType])
  @@index([level])
}

///////////////////////////
//PlanPricing Model
///////////////////////////

model PlanPricing {
  id String @id @default(cuid())

  planId String

  billingCycle BillingCycle

  durationDays Int

  price Decimal @db.Decimal(10, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, billingCycle])
  @@index([planId])
  @@index([billingCycle])
}

///////////////////////////
//Subscription Model
///////////////////////////

enum SubscriptionCreatedSource {
  SELF
  ADMIN
  MIGRATION
}

model Subscription {
  id String @id @default(cuid())

  subscriptionNumber String @unique

  planId String

  amountPaid Decimal @db.Decimal(10, 2)

  startDate DateTime

  endDate DateTime

  status SubscriptionStatus @default(ACTIVE)

  graceEndsAt DateTime?

  subscriptionType SubscriptionType @default(PAID)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  histories SubscriptionHistory[]

  ownerType SubscriptionOwnerType

  ownerId String

  payments Payment[]

  activations Activation[]

  createdSource SubscriptionCreatedSource @default(SELF)

  createdBy String?
  updatedBy String?

  machineLimit Int

  @@index([planId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

///////////////////////////
//Subscription History Model
///////////////////////////

model SubscriptionHistory {
  id String @id @default(cuid())

  subscriptionId String

  eventType SubscriptionEventType

  previousPlanId String?

  newPlanId String?

  amount Decimal @db.Decimal(10, 2)

  remarks String?

  createdAt DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([eventType])
  @@index([createdAt])
}

///////////////////////////
//Feature Model
///////////////////////////

model Feature {
  id String @id @default(cuid())

  code String @unique
  name String

  description String?

  category FeatureCategory?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plans PlanFeature[]

  deletedAt       DateTime?
  deletedByUserId String?
  isDeleted       Boolean   @default(false)
}

///////////////////////////
//Plan Feature Model
///////////////////////////

model PlanFeature {
  planId    String
  featureId String

  plan Plan @relation(fields: [planId], references: [id])

  feature Feature @relation(fields: [featureId], references: [id])

  @@id([planId, featureId])
}

///////////////////////////
//System Setting Model
///////////////////////////

model SystemSetting {
  id String @id @default(cuid())

  key String @unique

  value Json

  dataType SettingType

  description String?

  isPublic Boolean @default(false)

  updatedBy String?

  configVersion Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  group     String?

  @@index([group])
}

///////////////////////////
//Metric defination Model for custom fields
///////////////////////////

model MetricDefinition {
  id String @id @default(cuid())

  code String @unique
  name String

  category  MetricCategory
  source    MetricSource
  inputType MetricInputType @default(COUNT)

  description String?

  isActive Boolean @default(true)

  createdBy String?
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values MetricValue[]

  @@index([category])
  @@index([source])
  @@index([isActive])
}

///////////////////////////
//Metric value Model to store different custom values
///////////////////////////

model MetricValue {
  id String @id @default(cuid())

  metricId String
  agentId  String

  date DateTime

  value Decimal @db.Decimal(12, 2)

  createdBy String?
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  metric MetricDefinition @relation(fields: [metricId], references: [id], onDelete: Cascade)

  agent Agent @relation(fields: [agentId], references: [agentId], onDelete: Cascade)

  @@unique([metricId, agentId, date])
  @@index([metricId])
  @@index([agentId])
  @@index([date])
}

///////////////////////////
//Machine Model
///////////////////////////

model Machine {
  id String @id @default(cuid())

  machineCode String @unique

  machineName String?

  fingerprint String @unique

  watcherVersion String

  osName String?

  osVersion String?

  deviceName String?

  ipAddress String?

  isOnline Boolean @default(false)

  status MachineStatus @default(PENDING)

  watcherEnabled Boolean @default(true)

  currentAgentId String?

  lastHeartbeatAt DateTime?

  lastStartupAt DateTime?

  lastTransactionAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activations Activation[]
  sessions    MachineSession[]
  receipts    Receipt[]

  apiKeyHash      String?
  apiKeyIssuedAt  DateTime?
  apiKeyExpiresAt DateTime?

  isDeleted Boolean @default(false)

  deletedByUserId String?

  deletedAt DateTime?

  version Int @default(1)

  createdBy String?
  updatedBy String?

  auditLog AuditLog[]
  agent    Agent?     @relation(fields: [agentId], references: [agentId])
  agentId  String?

  @@index([currentAgentId])
  @@index([status])
}

///////////////////////////
//Activation Model
///////////////////////////

model Activation {
  id String @id @default(cuid())

  activationCode String @unique

  activationPasswordHash String?

  machineId String?

  subscriptionId String

  status ActivationStatus @default(NOT_ACTIVATED)

  activatedAt DateTime?

  deactivatedAt DateTime?

  lastValidatedAt DateTime?

  activatedBy String?

  remarks String?

  expiresAt DateTime

  assignedAgentId String?

  assignedByOwnerType SubscriptionOwnerType?

  assignedByOwnerId String?

  assignedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isCurrent Boolean @default(true)

  passwordGeneratedAt DateTime?

  passwordRegeneratedAt DateTime?

  machine Machine? @relation(fields: [machineId], references: [id], onDelete: Restrict)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([machineId])
  @@index([subscriptionId])
  @@index([status])
  @@index([expiresAt])
}

///////////////////////////
//MachineSession Model
///////////////////////////

enum SessionEndReason {
  NORMAL_SHUTDOWN
  SYSTEM_CRASH
  POWER_FAILURE
  WATCHER_CRASH
  UNKNOWN
  HEARTBEAT_TIMEOUT
}

enum MachineSessionStatus {
  ACTIVE
  CLOSED
}

model MachineSession {
  id String @id @default(cuid())

  machineSessionId String @unique

  machineId String

  startedAt DateTime

  endedAt DateTime?

  durationSeconds Int?

  lastHeartbeatAt DateTime?

  firstAgentId String?

  lastAgentId String?

  auditLogs AuditLog[]

  isUnexpectedStop Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status MachineSessionStatus @default(ACTIVE)

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Restrict)

  endedReason SessionEndReason?

  receipts Receipt[]

  @@index([machineId])
  @@index([machineId, status])
  @@index([startedAt])
  @@index([endedAt])
  @@index([lastHeartbeatAt])
  @@index([machineId, startedAt])
}

///////////////////////////
//Receipt Model
///////////////////////////

model Receipt {
  id String @id @default(cuid())

  receiptId String @unique

  machineId String

  agentId String

  receiptType ReceiptType

  transactionCategory TransactionCategory

  transactionType String

  status ReceiptStatus?

  transactionAt DateTime?

  amount Decimal? @db.Decimal(12, 2)

  count Int @default(1)

  charges Decimal? @db.Decimal(12, 2)

  stan String?

  rrn String?

  terminalId String?

  customerName String?

  customerAccount String?

  location String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy String?
  updatedBy String?

  machine Machine @relation(fields: [machineId], references: [id])

  agent       Agent         @relation(fields: [agentId], references: [agentId])
  FloatLedger FloatLedger[]

  machineSessionId String?

  machineSession MachineSession? @relation(fields: [machineSessionId], references: [machineSessionId])

  cashDenomination ReceiptCashDenomination?

  @@index([machineId])
  @@index([machineSessionId])
  @@index([agentId])
  @@index([transactionAt])
  @@index([status])
  @@index([receiptType])
  @@index([transactionCategory])
}

model ReceiptCashDenomination {
  id String @id @default(cuid())

  receiptRecordId String @unique

  notes500 Int @default(0)
  notes200 Int @default(0)
  notes100 Int @default(0)
  notes50  Int @default(0)
  notes20  Int @default(0)
  notes10  Int @default(0)
  notes5   Int @default(0)
  coins20  Int @default(0)
  coins10  Int @default(0)
  coins5   Int @default(0)
  coins2   Int @default(0)
  coins1   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receipt Receipt @relation(fields: [receiptRecordId], references: [id], onDelete: Cascade)
}

///////////////////////////
//AgentFloat Model
///////////////////////////

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model AgentFloat {
  id String @id @default(cuid())

  agentId String @unique

  openingFloat Decimal @db.Decimal(12, 2)

  currentCashInHand Decimal @db.Decimal(12, 2)

  currentCashInAccount Decimal @db.Decimal(12, 2)

  currentTotalFloat Decimal @db.Decimal(12, 2)

  isLocked Boolean @default(false)

  lastAdjustmentAt DateTime?

  lastReceiptAt DateTime?

  approvalStatus ApprovalStatus @default(APPROVED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy String?
  updatedBy String?

  agent Agent @relation(fields: [agentId], references: [agentId])
}

///////////////////////////
//FloatLedger Model
///////////////////////////

model FloatLedger {
  id String @id @default(cuid())

  agentId String

  receiptId String?

  ledgerType FloatLedgerType

  cashInHandChange Decimal @db.Decimal(12, 2)

  cashInAccountChange Decimal @db.Decimal(12, 2)

  balanceCashInHand Decimal @db.Decimal(12, 2)

  balanceCashInAccount Decimal @db.Decimal(12, 2)

  remarks String?

  approvedBy String?

  createdAt DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [agentId])

  receipt Receipt? @relation(fields: [receiptId], references: [receiptId])

  @@index([agentId])
  @@index([receiptId])
  @@index([createdAt])
  @@index([ledgerType])
}

///////////////////////////
//FloatAdjustmentRequest Model
///////////////////////////

model FloatAdjustmentRequest {
  id String @id @default(cuid())

  agentId String

  requestedCashInHand Decimal @db.Decimal(12, 2)

  requestedCashInAccount Decimal @db.Decimal(12, 2)

  systemCashInHand Decimal @db.Decimal(12, 2)

  systemCashInAccount Decimal @db.Decimal(12, 2)

  reason FloatAdjustmentReason

  description String?

  status FloatAdjustmentStatus @default(PENDING)

  requestedBy String

  approvedBy String?

  approvedAt DateTime?

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [agentId])

  @@index([agentId])
  @@index([status])
}

///////////////////////////
//AuditLog Model
///////////////////////////

model AuditLog {
  id String @id @default(cuid())

  userId String?

  machineId String?

  machineSessionId String?

  action AuditAction

  entityType AuditEntity

  entityId String

  description String?

  oldData Json?

  newData Json?

  ipAddress String?

  userAgent String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  machine Machine? @relation(fields: [machineId], references: [id], onDelete: SetNull)

  machineSession MachineSession? @relation(fields: [machineSessionId], references: [id], onDelete: SetNull)

  requestId String?

  @@index([userId])
  @@index([machineId])
  @@index([entityType])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
  @@index([machineSessionId])
}

///////////////////////////
//Payment Model
///////////////////////////

model Payment {
  id String @id @default(cuid())

  paymentNumber String @unique

  subscriptionId String?

  ownerType SubscriptionOwnerType

  ownerId String

  bcId String?

  amount Decimal @db.Decimal(12, 2)

  taxAmount Decimal @default(0) @db.Decimal(12, 2)

  totalAmount Decimal @db.Decimal(12, 2)

  paymentMethod PaymentMethod

  paymentProvider PaymentProvider

  status PaymentStatus

  transactionReference String?

  gatewayTransactionId String?

  gatewayResponse Json?

  receiptUrl String?

  failureReason String?

  remarks String?

  paidAt DateTime?

  planId String

  billingCycle BillingCycle

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  currency String @default("INR")

  invoiceNumber String? @unique

  @@index([subscriptionId])
  @@index([status])
  @@index([paymentMethod])
  @@index([paidAt])
  @@index([paymentProvider])
  @@index([paymentNumber])
}

///////////////////////////
//Notification Model
///////////////////////////

model Notification {
  id String @id @default(cuid())

  userId String?

  title   String
  message String

  type NotificationType @default(INFO)

  isRead Boolean @default(false)

  readAt DateTime?

  createdAt DateTime @default(now())

  isSent Boolean @default(false)

  sentAt DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([type])
}

///////////////////////////
//Communication Model
///////////////////////////

enum CommunicationChannel {
  EMAIL
  SMS
  PUSH
}

enum CommunicationStatus {
  PENDING
  SENT
  FAILED
}

model Communication {
  id String @id @default(cuid())

  userId String?

  channel CommunicationChannel
  status  CommunicationStatus  @default(PENDING)

  recipient String

  subject String?
  message String

  template String?

  otpId String?

  sentAt        DateTime?
  failureReason String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  referenceType String?
  referenceId   String?
  retryCount    Int     @default(0)

  @@index([userId])
  @@index([channel])
  @@index([status])
}

///////////////////////////
//RunningNumber Model for SUBSCRIPTION, Payment, Invoice
///////////////////////////

enum RunningNumberType {
  SUBSCRIPTION
  PAYMENT
  INVOICE
  MACHINE
  ACTIVATION
  MACHINE_SESSION
  RECEIPT
  CSP_VISIT
}

model RunningNumber {
  id String @id @default(cuid())

  type RunningNumberType @unique

  currentValue BigInt @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

///////////////////////////
//CSP VISIT Model
///////////////////////////

model CspVisit {
  id String @id @default(cuid())

  visitId String @unique

  cspAgentId       String
  visitedByAgentId String

  visitDate DateTime

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  photoUrl String?

  remarks String?

  points Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  csp Agent @relation("CspVisits", fields: [cspAgentId], references: [agentId], onDelete: Restrict)

  visitedBy Agent @relation("CspVisitsByAgent", fields: [visitedByAgentId], references: [agentId], onDelete: Restrict)

  customerReviews CspVisitCustomerReview[]

  @@index([cspAgentId])
  @@index([visitedByAgentId])
  @@index([visitDate])
  @@index([cspAgentId, visitDate])
}

///////////////////////////
//CUSTOMER REVIEW MODEL for CSP VISIT
///////////////////////////

model CspVisitCustomerReview {
  id String @id @default(cuid())

  visitId String

  customerName    String?
  customerAccount String?

  review String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visit CspVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
}
