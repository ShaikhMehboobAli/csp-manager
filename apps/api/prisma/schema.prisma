//////////////////////////////////////////////////
// User MODELS
//////////////////////////////////////////////////

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
  SUSPENDED
}

model User {
  id String @id @default(cuid())

  agentId String @unique

  email String @unique

  passwordHash String

  role UserRole

  status UserStatus @default(PENDING)

  isEmailVerified Boolean @default(false)

  isPhoneVerified Boolean @default(false)

  signupCompleted Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  createdBy String?
  updatedBy String?

  lastLoginAt DateTime?

  passwordChangedAt DateTime?

  // Why the super admin blocked / suspended the account (shown at login).
  statusReason String?

  statusChangedAt DateTime?

  agent Agent @relation(fields: [agentId], references: [agentId])

  sessions UserSession[]

  notifications Notification[]

  communications Communication[]

  auditLogs AuditLog[]

  OTP Otp[]

  @@index([agentId])
}

///////////////////////////
//User Session Model
///////////////////////////

model UserSession {
  id String @id @default(cuid())

  userId String

  refreshTokenHash String

  ipAddress String?

  userAgent String?

  deviceName String?

  expiresAt DateTime

  revokedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

///////////////////////////
//OTP Model
///////////////////////////

enum OtpPurpose {
  SIGNUP
  LOGIN
  FORGOT_PASSWORD
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
}

enum OTPChannel {
  EMAIL
  SMS
}

model Otp {
  id String @id @default(cuid())

  userId String

  purpose OtpPurpose

  otpCode String

  email String?

  phone String?

  expiresAt DateTime

  attempts Int @default(0)

  resendCount Int @default(0)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([purpose])
}

///////////////////////////
//BC Model
///////////////////////////

model BusinessCorrespondent {
  id String @id @default(cuid())

  bcId String @unique
  name String

  mobile  String?
  email   String?
  address String?

  status BusinessCorrespondentStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agents Agent[]

  linkRequests BcLinkRequest[]

  deletedAt DateTime?

  deletedByUserId String?

  isDeleted Boolean @default(false)

  @@index([status])
}

///////////////////////////
//Agent Model
///////////////////////////

model Agent {
  id String @id @default(cuid())

  agentId String @unique

  name String

  type AgentType

  /// CSP only: the team's working day ("HH:mm", IST), set by the CSP; used
  /// for late arrival / early leave in Team today.
  workdayStart String?
  workdayEnd   String?

  mobile  String?
  email   String?
  address String?

  /// When `email` was verified by OTP (KOs verify at machine activation or
  /// in the desktop cash panel). Cleared when the email changes.
  emailVerifiedAt DateTime?

  status AgentStatus @default(ACTIVE)

  selfRegistered Boolean @default(false)

  // Relationship with BC
  bcId                  String?
  businessCorrespondent BusinessCorrespondent? @relation(fields: [bcId], references: [bcId], onDelete: Restrict)

  // Self Relationship (CSP -> KO)
  parentAgentId String?

  parentAgent Agent? @relation("AgentHierarchy", fields: [parentAgentId], references: [agentId], onDelete: SetNull)

  childAgents Agent[] @relation("AgentHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // CSP limit (the CSP's float limit). Not a balance.
  cashLimit            Decimal? @db.Decimal(18, 2)
  // Opening float: cash in hand and cash in the account (holding).
  openingCash          Decimal? @db.Decimal(18, 2)
  openingCashInAccount Decimal? @db.Decimal(18, 2)

  linkedAt DateTime?

  // Set by an approved SUBSCRIBED_CSP link request (BC ₹799): the BC sees this
  // CSP's data only while the CSP's own subscription is active.
  bcLinkedByRequest Boolean @default(false)

  bcLinkRequests BcLinkRequest[]

  receipts           Receipt[]
  receiptDailyCounts ReceiptDailyCount[]
  cashPool           CashPool?
  agentCash          AgentCash?
  cashLedgerEntries  CashLedger[]           @relation("CashLedgerAgent")
  cashRequests       CashRequest[]
  cashSettlements    CashSettlement[]
  cashDues           CashDue[]
  cashDayCloses      CashDayClose[]
  cashTasks          CashTask[]
  cashAdjustments    CashDrawerAdjustment[]
  emailOtps          AgentEmailOtp[]

  users User?

  cspVisits CspVisit[] @relation("CspVisits")

  conductedCspVisits CspVisit[] @relation("CspVisitsByAgent")

  isDeleted Boolean @default(false)

  deletedByUserId String?

  deletedAt              DateTime?
  agentFloat             AgentFloat?
  floatLedger            FloatLedger[]
  floatAdjustmentRequest FloatAdjustmentRequest[]
  metricValues           MetricValue[]

  machines            Machine[]
  cspActivitySessions CspActivitySession[]

  isProfileCompleted Boolean @default(false)

  createdByAgentId String?

  createdBy String?
  updatedBy String?

  @@index([bcId])
  @@index([parentAgentId])
  @@index([type])
  @@index([status])
}

///////////////////////////
//Plan Model
///////////////////////////

model Plan {
  id String @id @default(cuid())

  code String @unique
  name String

  ownerType PlanOwnerType

  level Int

  machineLimit Int?

  isCustom Boolean @default(false)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pricings PlanPricing[]

  features PlanFeature[]

  subscriptions Subscription[]

  payments Payment[]

  deletedAt       DateTime?
  deletedByUserId String?

  isDeleted Boolean @default(false)

  @@index([ownerType])
  @@index([level])
}

///////////////////////////
//PlanPricing Model
///////////////////////////

model PlanPricing {
  id String @id @default(cuid())

  planId String

  billingCycle BillingCycle

  durationDays Int

  price Decimal @db.Decimal(10, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, billingCycle])
  @@index([planId])
  @@index([billingCycle])
}

///////////////////////////
//Subscription Model
///////////////////////////

enum SubscriptionCreatedSource {
  SELF
  ADMIN
  MIGRATION
}

model Subscription {
  id String @id @default(cuid())

  subscriptionNumber String @unique

  /// Price per machine (base, without GST) of the current plan, used to
  /// price an upgrade's difference. Null on rows created before upgrades.
  pricePerMachine Decimal? @db.Decimal(10, 2)

  /// Start of the current monthly period (purchase, or the last renewal).
  /// Upgrades are allowed only in the first 12 days of it.
  currentPeriodStart DateTime?

  /// Renews by mandate at endDate unless cancelled.
  autoRenew Boolean @default(true)

  /// Free trial: when the "trial ends soon" notification was sent.
  trialReminderSentAt DateTime?

  /// Cancelled by the CSP: no refund, works until endDate, never renews.
  cancelledAt  DateTime?
  cancelReason String?
  cancelledBy  String?

  /// Failed mandate charges for the renewal due at endDate (0–3).
  renewalAttempts      Int       @default(0)
  nextRenewalAttemptAt DateTime?
  lastRenewalFailure   String?
  /// Set when renewal failed after every retry (stopped at once).
  lapsedAt             DateTime?

  mandates SubscriptionMandate[]

  planId String

  amountPaid Decimal @db.Decimal(10, 2)

  startDate DateTime

  endDate DateTime

  status SubscriptionStatus @default(ACTIVE)

  graceEndsAt DateTime?

  subscriptionType SubscriptionType @default(PAID)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  histories SubscriptionHistory[]

  ownerType SubscriptionOwnerType

  ownerId String

  payments Payment[]

  activations Activation[]

  createdSource SubscriptionCreatedSource @default(SELF)

  createdBy String?
  updatedBy String?

  machineLimit Int

  @@index([planId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

///////////////////////////
//Subscription History Model
///////////////////////////

/// UPI autopay mandate for a subscription: charges the monthly amount on the
/// subscription's end date/time, for up to 25 years.
model SubscriptionMandate {
  id String @id @default(cuid())

  subscriptionId String

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  ownerId String

  provider MandateProvider

  /// Gateway ids (Razorpay subscription / token / customer).
  providerMandateId  String? @unique
  providerCustomerId String?

  status MandateStatus @default(PENDING)

  /// Amount charged every month (incl. GST).
  amount Decimal @db.Decimal(12, 2)

  /// Upgrade changed the monthly amount; the gateway mandate must be
  /// updated / re-approved before the next charge (Razorpay: update the
  /// subscription or create a new mandate).
  amountChangePending Boolean @default(false)

  frequency BillingCycle @default(MONTHLY)

  startAt DateTime

  /// startAt + 25 years.
  endAt DateTime

  /// Approval link for the customer (gateway), when there is one.
  authUrl String?

  activatedAt  DateTime?
  cancelledAt  DateTime?
  revokedAt    DateTime?
  revokeReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@index([subscriptionId])
  @@index([ownerId])
  @@index([status])
}

model SubscriptionHistory {
  id String @id @default(cuid())

  subscriptionId String

  eventType SubscriptionEventType

  previousPlanId String?

  newPlanId String?

  amount Decimal @db.Decimal(10, 2)

  remarks String?

  createdAt DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([eventType])
  @@index([createdAt])
}

///////////////////////////
//Feature Model
///////////////////////////

model Feature {
  id String @id @default(cuid())

  code String @unique
  name String

  description String?

  category FeatureCategory?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plans PlanFeature[]

  deletedAt       DateTime?
  deletedByUserId String?
  isDeleted       Boolean   @default(false)
}

///////////////////////////
//Plan Feature Model
///////////////////////////

model PlanFeature {
  planId    String
  featureId String

  plan Plan @relation(fields: [planId], references: [id])

  feature Feature @relation(fields: [featureId], references: [id])

  @@id([planId, featureId])
}

///////////////////////////
//System Setting Model
///////////////////////////

model SystemSetting {
  id String @id @default(cuid())

  key String @unique

  value Json

  dataType SettingType

  description String?

  isPublic Boolean @default(false)

  updatedBy String?

  configVersion Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  group     String?

  @@index([group])
}

///////////////////////////
//Metric defination Model for custom fields
///////////////////////////

model MetricDefinition {
  id String @id @default(cuid())

  code String @unique
  name String

  category  MetricCategory
  source    MetricSource
  inputType MetricInputType @default(COUNT)

  description String?

  isActive Boolean @default(true)

  createdBy String?
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values MetricValue[]

  @@index([category])
  @@index([source])
  @@index([isActive])
}

///////////////////////////
//Metric value Model to store different custom values
///////////////////////////

model MetricValue {
  id String @id @default(cuid())

  metricId String
  agentId  String

  date DateTime

  value Decimal @db.Decimal(12, 2)

  createdBy String?
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  metric MetricDefinition @relation(fields: [metricId], references: [id], onDelete: Cascade)

  agent Agent @relation(fields: [agentId], references: [agentId], onDelete: Cascade)

  @@unique([metricId, agentId, date])
  @@index([metricId])
  @@index([agentId])
  @@index([date])
}

///////////////////////////
//Machine Model
///////////////////////////

model Machine {
  id String @id @default(cuid())

  machineCode String @unique

  machineName String?

  fingerprint String @unique

  watcherVersion String

  osName String?

  osVersion String?

  deviceName String?

  ipAddress String?

  isOnline Boolean @default(false)

  status MachineStatus @default(PENDING)

  watcherEnabled Boolean @default(true)

  // Super admin overrides for this machine: { services: { CODE: bool },
  // receiptCashDenominationConfirm: bool }. Merged with the global AppSetting.
  desktopControls Json?

  currentAgentId String?

  /// Who is logged in to cash management on this PC: any agent of the
  /// owner CSP's family (the CSP or one of its KOs). Set by the SBI kiosk
  /// login (activity start) or an email OTP login; null = currentAgentId.
  cashAgentId          String?
  cashAgentLoginMethod CashLoginMethod?
  cashAgentLoginAt     DateTime?

  lastHeartbeatAt DateTime?

  lastStartupAt DateTime?

  lastTransactionAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activations         Activation[]
  sessions            MachineSession[]
  cspActivitySessions CspActivitySession[]
  receipts            Receipt[]
  receiptDailyCounts  ReceiptDailyCount[]

  apiKeyHash      String?
  apiKeyIssuedAt  DateTime?
  apiKeyExpiresAt DateTime?

  // ECDSA P-256 public key (PEM) of this install's device key, sent at
  // activation. When set, requests must be signed and the API key alone is
  // refused. Replaced on every (re-)activation.
  devicePublicKey             String?
  devicePublicKeyRegisteredAt DateTime?

  isDeleted Boolean @default(false)

  deletedByUserId String?

  deletedAt DateTime?

  version Int @default(1)

  createdBy String?
  updatedBy String?

  auditLog AuditLog[]
  agent    Agent?     @relation(fields: [agentId], references: [agentId])
  agentId  String?

  @@index([currentAgentId])
  @@index([status])
}

///////////////////////////
//Activation Model
///////////////////////////

model Activation {
  id String @id @default(cuid())

  activationCode String @unique

  activationPasswordHash String?

  // DEV ONLY — REMOVE BEFORE PRODUCTION (pre-production checklist 2.11).
  // Plain activation password so owners can see it again until activation
  // emails exist. Never written when NODE_ENV=production.
  activationPasswordPlain String?

  machineId String?

  subscriptionId String

  status ActivationStatus @default(NOT_ACTIVATED)

  activatedAt DateTime?

  deactivatedAt DateTime?

  lastValidatedAt DateTime?

  activatedBy String?

  remarks String?

  expiresAt DateTime

  assignedAgentId String?

  assignedByOwnerType SubscriptionOwnerType?

  assignedByOwnerId String?

  assignedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isCurrent Boolean @default(true)

  passwordGeneratedAt DateTime?

  passwordRegeneratedAt DateTime?

  machine Machine? @relation(fields: [machineId], references: [id], onDelete: Restrict)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  revokeRequests ActivationRevokeRequest[]

  @@index([machineId])
  @@index([subscriptionId])
  @@index([status])
  @@index([expiresAt])
}

///////////////////////////
//MachineSession Model
///////////////////////////

enum SessionEndReason {
  NORMAL_SHUTDOWN
  SYSTEM_CRASH
  POWER_FAILURE
  WATCHER_CRASH
  UNKNOWN
  HEARTBEAT_TIMEOUT
}

enum MachineSessionStatus {
  ACTIVE
  CLOSED
}

/// Why a CSP activity (SBI login) session ended.
enum ActivityEndReason {
  LOGOUT
  AUTO_LOGOUT
  APP_CLOSE
  HEARTBEAT_TIMEOUT
  REPLACED
}

/// A CSP's SBI login session on a machine, driven by the desktop UI
/// heartbeat. Separate from MachineSession (machine/service liveness).
model CspActivitySession {
  id                String               @id @default(cuid())
  activitySessionId String               @unique
  machineId         String
  agentId           String
  status            MachineSessionStatus @default(ACTIVE)
  startedAt         DateTime             @default(now())
  lastHeartbeatAt   DateTime             @default(now())
  endedAt           DateTime?
  durationSeconds   Int?
  endedReason       ActivityEndReason?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Restrict)
  agent   Agent   @relation(fields: [agentId], references: [agentId], onDelete: Restrict)

  @@index([machineId, status])
  @@index([agentId, startedAt])
  @@index([status, lastHeartbeatAt])
}

model MachineSession {
