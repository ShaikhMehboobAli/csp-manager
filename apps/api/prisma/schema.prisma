  AEPS
  ACCOUNT
  CARD
  BBPS
  MICRO_ATM
  ACCOUNT_OPENING
  APY
  PMJJBY
  PMSBY
  MUDRA_LOAN
  UNKNOWN
}

enum BusinessCorrespondentStatus {
  ACTIVE
  INACTIVE
}

enum SubscriptionOwnerType {
  BC
  CSP
}

enum SubscriptionEventType {
  PURCHASE
  UPGRADE
  RENEWAL
  CANCELLATION
}

enum SubscriptionType {
  TRIAL
  PAID
  PROMOTIONAL
  LIFETIME
}

enum MachineStatus {
  PENDING
  ACTIVE
  OFFLINE
  BLOCKED
  RETIRED
}

enum FeatureCategory {
  DASHBOARD
  RECEIPT
  FLOAT
  REPORT
  MACHINE
  SUBSCRIPTION
  USER
  NOTIFICATION
  SETTINGS
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

