{
  "name": "csp-manager",
  "version": "1.0.0",
  "private": true,
  "description": "CSP Manager Backend API & Services",
  "scripts": {
    "build": "npm --prefix apps/api run build",
    "start": "npm --prefix apps/api run start",
    "dev": "npm --prefix apps/api run dev",
    "prisma:generate": "npm --prefix apps/api exec prisma generate",
    "prisma:migrate": "npm --prefix apps/api exec prisma migrate deploy",
    "seed": "npm --prefix apps/api exec prisma db seed",
    "seed:super-admin": "npm --prefix apps/api run seed:super-admin",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:reload": "pm2 reload ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop csp-manager-api",
    "pm2:logs": "pm2 logs csp-manager-api",
    "deploy": "./deploy.sh"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
